---
import { length } from "astro:schema";
import Layout from "../../layouts/Layout.astro";
import Footer from "../Home/Footer.astro";
import PhotoCard from "../Home/PhotoCard.astro";
import VideoPlayer from "../Home/VideoPlayer.astro";
import Header from "../Home/Header.astro";
import "../../styles/style.css";
import "../../styles/project-template.css";
import { cachedFetch } from "../../lib/serverCache";

const { project } = Astro.props;

const headerLinks = [
    { name: "Portfolio", href: "/#portfolio" },
    { name: "Studio", href: "/#about" },
    { name: "Processo", href: "/#process" },
    { name: "Contatti", href: "/#contact" },
];

// Fetch related media
let media = await cachedFetch(
    new URL("/api/media?slug=" + project.slug, Astro.request.url),
    { ttl: 300_000 },
);
if (media.error) media = [];
const photos = media.filter((media: any) => media.tipo === "image");
const videos = media.filter((media: any) => media.tipo === "video");
---

<Layout>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    />

    <!-- ── NAV ── -->
    <Header links={headerLinks} />

    <!-- ── PROJECT HERO ── -->
    <section class="project-hero">
        <div class="project-hero-bg"></div>
        <div class="project-hero-overlay"></div>
        <div class="project-hero-line"></div>

        <a class="project-breadcrumb" href="/#portfolio">
            <svg viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>Portfolio</span>
        </a>

        <div class="project-hero-content">
            <div class="project-eyebrow">Evento &mdash; 2024</div>
            <h1 class="project-hero-title">{project.nome}</h1>
            <!-- <h1 class="project-hero-title">{project.nome}</h1> -->
            <div class="project-meta-row">
                <div class="project-meta-item">
                    <span class="project-meta-label">Cliente</span>
                    <span class="project-meta-value">{project.nome}</span>
                </div>
                <div class="project-meta-item">
                    <span class="project-meta-label">Data</span>
                    <span class="project-meta-value">14 Aprile 2024</span>
                </div>
                <div class="project-meta-item">
                    <span class="project-meta-label">Categoria</span>
                    <span class="project-meta-value">
                        Sport Action / Event Coverage
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── PROJECT INFO ── -->
    <section class="project-info">
        <div class="project-description reveal">
            <p>{project.descrizione}</p>
        </div>
        <div class="project-sidebar">
            <div class="sidebar-block reveal reveal-delay-1">
                <div class="sidebar-block-label">Servizi erogati</div>
                <div class="tag-list">
                    <span class="tag">Sport Action</span>
                    <span class="tag">Event Coverage</span>
                    <span class="tag">Video Production</span>
                    <span class="tag">Drone Aerial</span>
                    <span class="tag">Post-produzione</span>
                </div>
            </div>
            <div class="sidebar-block reveal reveal-delay-2">
                <div class="sidebar-block-label">Consegna</div>
                <div class="sidebar-block-value">{project.scatti}</div>
            </div>
        </div>
    </section>

    <!-- ── MASONRY GALLERY ── -->
    <section class="gallery-section">
        <div class="gallery-header">
            <div class="reveal">
                <div class="section-label">Gallery del progetto</div>
                <h2 class="section-title">Tutti gli scatti</h2>
            </div>
            <!-- <div class="filter-tabs reveal reveal-delay-1">
        <button class="filter-tab active" data-filter="all">Tutti</button>
        <button class="filter-tab" data-filter="action">Action</button>
        <button class="filter-tab" data-filter="portraits">Ritratti</button>
        <button class="filter-tab" data-filter="aerial">Drone</button>
        <button class="filter-tab" data-filter="detail">Dettagli</button>
      </div> -->
        </div>

        <div class="masonry-grid" id="masonryGrid">
            {photos.map((photo: any, index: number) => (
                <PhotoCard photo={photo} index={index} />
            ))}
        </div>
    </section>

    <!-- ── VIDEO REEL ── -->
    {videos.length > 0 && (
        <section class="video-section">
            <div class="video-header reveal">
                <div class="section-label">Produzione video</div>
                <h2 class="section-title">Highlight Reel</h2>
            </div>
            <div class="video-container">
                {videos.map((video: any) => (
                    <VideoPlayer
                        src={video.url}
                        controls={false}
                        autoplay={true}
                        width={540}
                        height={960}
                        loop={true}
                        muted={true}
                    />
                ))}
            </div>
        </section>
    )}

    <!-- ── RELATED PROJECTS ── -->
    <!-- <section class="related-section">
    <div class="related-header reveal">
      <div class="section-label">Scopri altri lavori</div>
      <h2 class="section-title">Progetti correlati</h2>
    </div>
    <div class="related-grid">
      <a class="related-card reveal" href="#">
        <img
          src="https://images.unsplash.com/photo-1548690312-e3b507d8c110?w=800&q=80"
          alt="Swimming"
          loading="lazy"
        />
        <div class="related-card-overlay">
          <div class="related-card-cat">Sport — Campionati Nazionali</div>
          <div class="related-card-title">Acqua & Velocità</div>
        </div>
      </a>
      <a class="related-card reveal reveal-delay-1" href="#">
        <img
          src="https://images.unsplash.com/photo-1599058917765-a780eda07a3e?w=800&q=80"
          alt="Football"
          loading="lazy"
        />
        <div class="related-card-overlay">
          <div class="related-card-cat">Calcio — Serie A Coverage</div>
          <div class="related-card-title">Il Gol del Campione</div>
        </div>
      </a>
      <a class="related-card reveal reveal-delay-2" href="#">
        <img
          src="https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?w=800&q=80"
          alt="Cycling"
          loading="lazy"
        />
        <div class="related-card-overlay">
          <div class="related-card-cat">Ciclismo — Gran Fondo 2024</div>
          <div class="related-card-title">Sulle Alpi in Sella</div>
        </div>
      </a>
    </div>
  </section> -->

    <!-- ── CTA ── -->
    <section class="cta-section" id="contact">
        <div class="cta-bg"></div>
        <div class="reveal">
            <div class="section-label" style="justify-content:center;">
                Hai un progetto simile?
            </div>
            <h2 class="section-title">
                Raccontiamo
                <br />
                la tua storia
            </h2>
            <div class="cta-divider"></div>
            <p class="section-body">
                Che si tratti di una maratona, di un campionato o di un evento
                brand, portiamo la stessa cura e la stessa intensità in ogni
                progetto.
            </p>
            <div style="display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap;">
                <a class="btn-primary" href="mailto:ugactionmedia@gmail.com">
                    Scrivici subito
                </a>
                <a class="btn-ghost" href="/#portfolio">
                    Vedi il portfolio
                </a>
            </div>
        </div>
    </section>
    <Footer />

    <!-- ── LIGHTBOX ── -->
    <div
        class="lightbox"
        id="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Visualizzatore immagini"
    >
        <button class="lightbox-close" id="lbClose" aria-label="Chiudi">
            <svg viewBox="0 0 24 24">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <button class="lightbox-prev" id="lbPrev" aria-label="Precedente">
            <svg viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
        <button class="lightbox-next" id="lbNext" aria-label="Successiva">
            <svg viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
        <div class="lightbox-inner">
            <div class="lightbox-img-wrap">
                <img id="lbImg" src="" alt="" />
            </div>
            <div class="lightbox-caption">
                <div class="lightbox-caption-text">
                    <div class="lightbox-caption-cat" id="lbCat"></div>
                    <div class="lightbox-caption-title" id="lbTitle"></div>
                </div>
                <div class="lightbox-counter">
                    <span id="lbCurrent">01</span>/<span id="lbTotal">12</span>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        /* ── Intersection reveal ── */
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((e) => {
                    if (e.isIntersecting) e.target.classList.add("visible");
                });
            },
            { threshold: 0.12 },
        );
        document
            .querySelectorAll(".reveal, .stat-item")
            .forEach((el) => io.observe(el));

        /* ── Navbar scroll ── */
        window.addEventListener("scroll", () => {
            document.querySelector("nav").style.background =
                window.scrollY > 60
                    ? "rgba(10,10,10,0.97)"
                    : "rgba(10,10,10,0.85)";
        });

        /* ── Gallery filter ── */
        const items = Array.from(document.querySelectorAll(".masonry-item"));
        document.querySelectorAll(".filter-tab").forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelectorAll(".filter-tab")
                    .forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                const filter = btn.dataset.filter;
                items.forEach((item) => {
                    const match =
                        filter === "all" || item.dataset.cat === filter;
                    item.style.display = match ? "" : "none";
                });
            });
        });

        /* ── Lightbox ── */
        const lightbox = document.getElementById("lightbox");
        const lbImg = document.getElementById("lbImg");
        const lbCat = document.getElementById("lbCat");
        const lbTitle = document.getElementById("lbTitle");
        const lbCurrent = document.getElementById("lbCurrent");
        const lbTotal = document.getElementById("lbTotal");

        let currentIndex = 0;
        let visibleItems = [];

        function openLightbox(index) {
            visibleItems = items.filter((i) => i.style.display !== "none");
            currentIndex = index;
            showSlide(currentIndex);
            lightbox.classList.add("open");
            document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
            lightbox.classList.remove("open");
            document.body.style.overflow = "";
        }

        function showSlide(idx) {
            const el = visibleItems[idx];
            if (!el) return;
            lbImg.src = el.dataset.src;
            lbCat.textContent = el.dataset.catLabel;
            lbTitle.textContent = el.dataset.title;
            lbCurrent.textContent = String(idx + 1).padStart(2, "0");
            lbTotal.textContent = String(visibleItems.length).padStart(2, "0");
            currentIndex = idx;
        }

        items.forEach((item, i) => {
            item.addEventListener("click", () => {
                visibleItems = items.filter(
                    (it) => it.style.display !== "none",
                );
                const visIdx = visibleItems.indexOf(item);
                openLightbox(visIdx >= 0 ? visIdx : 0);
            });
        });

        document
            .getElementById("lbClose")
            .addEventListener("click", closeLightbox);
        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) closeLightbox();
        });

        document.getElementById("lbPrev").addEventListener("click", () => {
            showSlide(
                (currentIndex - 1 + visibleItems.length) % visibleItems.length,
            );
        });
        document.getElementById("lbNext").addEventListener("click", () => {
            showSlide((currentIndex + 1) % visibleItems.length);
        });

        document.addEventListener("keydown", (e) => {
            if (!lightbox.classList.contains("open")) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowLeft")
                showSlide(
                    (currentIndex - 1 + visibleItems.length) %
                        visibleItems.length,
                );
            if (e.key === "ArrowRight")
                showSlide((currentIndex + 1) % visibleItems.length);
        });

        /* featured shot lightbox */
        document
            .querySelector(".featured-shot-wrap")
            .addEventListener("click", () => {
                visibleItems = items.filter(
                    (it) => it.style.display !== "none",
                );
                openLightbox(0);
            });
    </script>
</Layout>
