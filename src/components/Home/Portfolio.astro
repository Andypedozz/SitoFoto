---
import ProjectCard from "./ProjectCard.astro";

const { projects } = Astro.props;
---
<section class="portfolio" id="portfolio">
    <div class="portfolio-header reveal">
        <div>
            <div class="section-label">Il nostro lavoro</div>
            <h2 class="section-title">Portfolio Selezionato</h2>
        </div>
        <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">Tutto</button>
            <button class="filter-tab" data-filter="sport">Sport</button>
            <button class="filter-tab" data-filter="eventi">Eventi</button>
            <button class="filter-tab" data-filter="ritratti">Ritratti</button>
        </div>
    </div>

    <div class="portfolio-controls">
        <div class="portfolio-progress-wrap">
            <div class="portfolio-progress-bar" id="galleryProgress"></div>
        </div>
        <button
            class="scroll-btn"
            id="scrollLeft"
            aria-label="Scorri a sinistra"
        >
            <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <polyline points="10 3 5 8 10 13"></polyline>
            </svg>
        </button>
        <button
            class="scroll-btn"
            id="scrollRight"
            aria-label="Scorri a destra"
        >
            <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <polyline points="6 3 11 8 6 13"></polyline>
            </svg>
        </button>
    </div>

    <div class="gallery-track-wrap">
        <div class="gallery-track" id="galleryTrack">
            {projects.map((project: any) => <ProjectCard project={project} />)}
        </div>
    </div>
</section>
