<style>
    /* ── FEATURED WORK ── */
    .featured {
        background: var(--black);
    }

    .featured-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5px;
        margin-top: 3.5rem;
    }

    .featured-item {
        position: relative;
        aspect-ratio: 16/10;
        overflow: hidden;
        cursor: pointer;
    }

    .featured-item.wide {
        grid-column: 1 / 3;
        aspect-ratio: 21/9;
    }

    .featured-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.75s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        filter: brightness(0.75);
    }

    .featured-item:hover img {
        transform: scale(1.06);
        filter: brightness(0.9);
    }

    .featured-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 2.5rem 2rem 1.8rem;
        background: linear-gradient(
            to top,
            rgba(10, 10, 10, 0.9) 0%,
            transparent 100%
        );
        transform: translateY(8px);
        opacity: 0.85;
        transition:
            transform 0.4s ease,
            opacity 0.4s ease;
    }

    .featured-item:hover .featured-caption {
        transform: none;
        opacity: 1;
    }

    .featured-caption-cat {
        font-size: 0.66rem;
        font-weight: 400;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 0.4rem;
    }

    .featured-caption h3 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        letter-spacing: 0.04em;
        color: var(--white);
    }

    @media (max-width: 900px) {
        .featured-grid {
            grid-template-columns: 1fr;
        }

        .featured-item.wide {
            grid-column: 1;
            aspect-ratio: 16/9;
        }
    }
</style>
<section class="featured" id="featured">
    <div class="reveal">
        <div class="section-label">Progetti di punta</div>
        <h2 class="section-title">Lavori in evidenza</h2>
    </div>
    <div class="featured-grid reveal">
        <div class="featured-item">
            <img
                src="https://images.unsplash.com/photo-1548690312-e3b507d8c110?w=800&q=80"
                alt="Swimming"
                loading="lazy"
            />
            <div class="featured-caption">
                <div class="featured-caption-cat">
                    Sport — Campionati Nazionali
                </div>
                <h3>Acqua & Velocità</h3>
            </div>
        </div>
        <div class="featured-item">
            <img
                src="https://images.unsplash.com/photo-1599058917765-a780eda07a3e?w=800&q=80"
                alt="Football"
                loading="lazy"
            />
            <div class="featured-caption">
                <div class="featured-caption-cat">
                    Calcio — Serie A Coverage
                </div>
                <h3>Il Gol del Campione</h3>
            </div>
        </div>
    </div>
</section>
