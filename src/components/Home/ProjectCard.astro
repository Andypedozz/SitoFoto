---
const { project } = Astro.props;
---

<style>
    /* project card */
    .proj-card {
        position: relative;
        flex-shrink: 0;
        overflow: hidden;
        background: var(--black-2);
        cursor: pointer;
        margin: 0.5%;
    }
    /* size variants */
    .proj-card.tall {
        width: 320px;
        height: 480px;
    }
    .proj-card.wide {
        width: 520px;
        height: 340px;
    }
    .proj-card.square {
        width: 340px;
        height: 340px;
    }

    .proj-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition:
            transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            filter 0.5s ease;
        filter: grayscale(25%) brightness(0.88);
    }
    .proj-card:hover img {
        transform: scale(1.07);
        filter: grayscale(0%) brightness(1);
    }
    .proj-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            160deg,
            transparent 40%,
            rgba(10, 10, 10, 0.92) 100%
        );
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.8rem;
        transition: background 0.4s ease;
    }
    .proj-card:hover .proj-card-overlay {
        background: linear-gradient(
            160deg,
            transparent 20%,
            rgba(10, 10, 10, 0.95) 100%
        );
    }
    .proj-card-cat {
        font-size: 0.65rem;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 0.4rem;
        transform: translateY(6px);
        opacity: 0.8;
        transition:
            transform 0.35s ease,
            opacity 0.35s ease;
    }
    .proj-card:hover .proj-card-cat {
        transform: none;
        opacity: 1;
    }
    .proj-card-title {
        font-family: var(--font-display);
        font-size: 1.45rem;
        letter-spacing: 0.04em;
        line-height: 1.05;
        color: var(--white);
        margin-bottom: 0.6rem;
        transform: translateY(6px);
        transition: transform 0.35s 0.04s ease;
    }
    .proj-card:hover .proj-card-title {
        transform: none;
    }
    .proj-card-meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        opacity: 0;
        transform: translateY(10px);
        transition:
            opacity 0.3s 0.08s ease,
            transform 0.3s 0.08s ease;
    }
    .proj-card:hover .proj-card-meta {
        opacity: 1;
        transform: none;
    }
    .proj-card-meta span {
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--white-dim);
    }
    .proj-card-meta span + span::before {
        content: "·";
        margin-right: 0.8rem;
        color: rgba(255, 255, 255, 0.2);
    }
    .proj-card-tag {
        position: absolute;
        top: 1.2rem;
        left: 1.2rem;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--white);
        background: var(--red);
        padding: 0.28rem 0.7rem;
    }
    .proj-card-num {
        position: absolute;
        top: 1.2rem;
        right: 1.4rem;
        font-family: var(--font-display);
        font-size: 3.5rem;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.06);
        line-height: 1;
        transition: color 0.3s;
        pointer-events: none;
    }
    .proj-card:hover .proj-card-num {
        color: rgba(224, 32, 32, 0.12);
    }
</style>
<div class="proj-card tall" data-cat="sport" onclick=`window.location.href = '/${project.slug}'`>
    <img
        src={project.copertina}
        alt="Sprint Finale"
        loading="lazy"
    />
    <div class="proj-card-overlay">
        <div class="proj-card-cat">Atletica Leggera</div>
        <div class="proj-card-title">{project.nome}</div>
        <div class="proj-card-meta">
            <span>Sport</span><span>2024</span>
        </div>
    </div>
</div>
