---
const { project } = Astro.props;
---
<div class="proj-card tall" data-cat="sport" onclick=`window.location.href = '/${project.slug}'`>
    <img
        src={project.copertina}
        alt="Sprint Finale"
        loading="lazy"
    />
    <div class="proj-card-overlay">
        <div class="proj-card-cat">Atletica Leggera</div>
        <div class="proj-card-title">{project.nome}</div>
        <div class="proj-card-meta">
            <span>Sport</span><span>2024</span>
        </div>
    </div>
</div>
