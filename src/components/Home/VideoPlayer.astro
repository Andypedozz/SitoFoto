---
interface Props {
  src: string;
  type?: "local" | "external";
  autoplay?: boolean;
  controls?: boolean;
  width?: string | number;
  height?: string | number;
  muted?: boolean;
  loop?: boolean;
  class?: string;
}

const {
  src,
  type = "local",
  autoplay = false,
  controls = true,
  width = "100%",
  height = "auto",
  muted = false,
  loop = false,
  class: className = "",
} = Astro.props;

/**
 * Converte numeri in px automaticamente
 */
const normalizeSize = (value: string | number) =>
  typeof value === "number" ? `${value}px` : value;
---

<div
  class={`video-player ${className}`}
  style={`width:${normalizeSize(width)}; height:${normalizeSize(height)};`}
>
  {
    type === "external" ? (
      <iframe
        src={src}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    ) : (
      <video
        src={src}
        autoplay={autoplay}
        controls={controls}
        muted={muted}
        loop={loop}
        playsinline
      >
        Il tuo browser non supporta il tag video.
      </video>
    )
  }
</div>

<style>
  .video-player {
    position: relative;
    overflow: hidden;
  }

  .video-player iframe,
  .video-player video {
    display: block;
    border: none;

    /* IMPORTANTISSIMO:
       usa sempre le dimensioni del wrapper */
    width: 100%;
    height: 100%;
  }

  .video-player video {
    object-fit: contain;
  }
</style>