---
import ReviewCard from "./ReviewCard.astro";

const { feedbacks } = Astro.props;
---

<style>
    /* ── TESTIMONIALS ── */
    .testimonials {
        background: var(--black);
    }

    .testi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5px;
        margin-top: 3.5rem;
    }

    .testi-card {
        background: var(--black-2);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2.4rem;
        transition: border-color 0.3s;
    }

    .testi-card:hover {
        border-color: var(--red);
    }

    .testi-quote {
        font-family: var(--font-display);
        font-size: 3rem;
        line-height: 1;
        color: var(--red);
        margin-bottom: 1.2rem;
        opacity: 0.6;
    }

    .testi-text {
        font-size: 0.95rem;
        line-height: 1.75;
        color: var(--white-dim);
        margin-bottom: 2rem;
        font-style: italic;
    }

    .testi-author {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .testi-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        border: 2px solid var(--red);
    }

    .testi-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .testi-name {
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--white);
        display: block;
    }

    .testi-role {
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--red);
        display: block;
        margin-top: 0.2rem;
    }

    @media (max-width: 900px) {
        .testi-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{
    feedbacks.length > 0 && (
        <section class="testimonials" id="testimonials">
            <div class="reveal">
                <div class="section-label">Cosa dicono di noi</div>
                <h2 class="section-title">Clienti & Feedback</h2>
            </div>
            <div class="testi-grid">
                {feedbacks.map((f: any) => (
                    <ReviewCard review={f} />
                ))}
            </div>
        </section>
    )
}
