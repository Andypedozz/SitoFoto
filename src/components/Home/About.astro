<style>
    /* ── ABOUT ── */
    .about {
        background: var(--black-2);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: center;
    }

    .about-image {
        position: relative;
        aspect-ratio: 4/5;
        overflow: hidden;
    }

    .about-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(30%);
        transition: filter 0.5s;
    }

    .about-image:hover img {
        filter: grayscale(0%);
    }

    .about-image::after {
        content: "";
        position: absolute;
        bottom: -1.5rem;
        right: -1.5rem;
        width: 40%;
        height: 40%;
        border-right: 3px solid var(--red);
        border-bottom: 3px solid var(--red);
        pointer-events: none;
    }

    .about-image::before {
        content: "";
        position: absolute;
        top: -1.5rem;
        left: -1.5rem;
        width: 40%;
        height: 40%;
        border-left: 3px solid rgba(224, 32, 32, 0.3);
        border-top: 3px solid rgba(224, 32, 32, 0.3);
        pointer-events: none;
        z-index: 1;
    }

    .about-badge {
        position: absolute;
        bottom: 1.5rem;
        right: -2.5rem;
        background: var(--red);
        color: var(--white);
        padding: 1.4rem;
        text-align: center;
        z-index: 2;
        min-width: 110px;
    }

    .about-badge strong {
        display: block;
        font-family: var(--font-display);
        font-size: 2rem;
        letter-spacing: 0.04em;
    }

    .about-badge span {
        display: block;
        font-size: 0.62rem;
        font-weight: 400;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-top: 0.2rem;
    }

    .about-text .section-body {
        margin-bottom: 2rem;
    }

    .about-services {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        margin-top: 2rem;
    }

    .service-chip {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.78rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--white-dim);
        padding: 0.7rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .service-chip::before {
        content: "";
        display: block;
        width: 4px;
        height: 4px;
        background: var(--red);
        flex-shrink: 0;
    }

    @media (max-width: 900px) {
        .about {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .about-image {
            max-width: 480px;
        }

        .about-badge {
            right: 0;
        }
    }
</style>
<section class="about" id="about">
    <div class="about-image reveal">
        <img
            src="https://images.unsplash.com/photo-1554151228-14d9def656e4?w=800&q=80"
            alt="Fotografo UG Action Media"
            loading="lazy"
        />
    </div>
    <div class="about-text">
        <div class="section-label reveal">Chi siamo</div>
        <h2 class="section-title reveal">
            Siamo la lente<br />dell'azione vera
        </h2>
        <p class="section-body reveal">
            UG Action Media nasce dalla passione per il movimento e per la
            storia che ogni atleta porta con sé. Non siamo semplici fotografi:
            siamo narratori visivi che vivono il campo, il ring e la pista
            insieme ai protagonisti.
        </p>
        <p class="section-body reveal reveal-delay-1" style="margin-top:1rem;">
            Specializziamo in sport action, eventi corporate, shooting per brand
            e produzioni video che catturano l'autenticità del momento.
        </p>
        <div class="about-services reveal reveal-delay-2">
            <div class="service-chip">Fotografia Sportiva</div>
            <div class="service-chip">Video Production</div>
            <div class="service-chip">Event Coverage</div>
            <div class="service-chip">Brand Storytelling</div>
            <div class="service-chip">Drone & Aerial</div>
            <div class="service-chip">Post Production</div>
        </div>
        <a
            class="btn-primary"
            href="#contact"
            style="display:inline-block;margin-top:2.5rem;">Lavora con noi</a
        >
    </div>
</section>
