<style>
    /* ── PROCESS ── */
    .process {
        background: var(--black-2);
        text-align: center;
    }

    .process-header {
        max-width: 560px;
        margin: 0 auto 4.5rem;
    }

    .process-header .section-label {
        justify-content: center;
    }

    .process-header .section-label::before {
        display: none;
    }

    .process-steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        position: relative;
    }

    .process-steps::before {
        content: "";
        position: absolute;
        top: 2rem;
        left: 12.5%;
        right: 12.5%;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--red),
            transparent
        );
    }

    .step {
        padding: 0 2rem;
        opacity: 0;
        transform: translateY(24px);
        transition:
            opacity 0.7s ease,
            transform 0.7s ease;
    }

    .step.visible {
        opacity: 1;
        transform: none;
    }

    .step:nth-child(2) {
        transition-delay: 0.15s;
    }

    .step:nth-child(3) {
        transition-delay: 0.3s;
    }

    .step:nth-child(4) {
        transition-delay: 0.45s;
    }

    .step-num {
        width: 4rem;
        height: 4rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.8rem;
        font-family: var(--font-display);
        font-size: 1.3rem;
        letter-spacing: 0.06em;
        color: var(--red);
        background: var(--black-2);
        position: relative;
        z-index: 1;
        transition:
            background 0.3s,
            border-color 0.3s;
    }

    .step:hover .step-num {
        background: var(--red);
        color: var(--white);
        border-color: var(--red);
    }

    .step h3 {
        font-family: var(--font-display);
        font-size: 1.15rem;
        letter-spacing: 0.06em;
        color: var(--white);
        margin-bottom: 0.8rem;
    }

    .step p {
        font-size: 0.88rem;
        line-height: 1.7;
        color: var(--white-dim);
    }

    @media (max-width: 900px) {
        .process-steps {
            grid-template-columns: 1fr 1fr;
        }

        .process-steps::before {
            display: none;
        }
    }
</style>
<section class="process" id="process">
    <div class="process-header reveal">
        <div class="section-label">Come lavoriamo</div>
        <h2 class="section-title">Il nostro processo</h2>
        <p class="section-body" style="margin:0 auto;">
            Dalla prima call fino alla consegna del materiale finale, ogni passo
            è curato nei minimi dettagli.
        </p>
    </div>
    <div class="process-steps">
        <div class="step">
            <div class="step-num">01</div>
            <h3>Brief & Visione</h3>
            <p>
                Ascoltiamo la tua storia, i tuoi obiettivi e definiamo insieme
                la direzione creativa del progetto.
            </p>
        </div>
        <div class="step">
            <div class="step-num">02</div>
            <h3>Sopralluogo</h3>
            <p>
                Studiamo location, luci e dinamiche per pianificare ogni angolo
                e ogni momento da catturare.
            </p>
        </div>
        <div class="step">
            <div class="step-num">03</div>
            <h3>Shooting & Riprese</h3>
            <p>
                Entriamo in azione con il nostro equipment professionale,
                adattandoci in tempo reale.
            </p>
        </div>
        <div class="step">
            <div class="step-num">04</div>
            <h3>Editing & Consegna</h3>
            <p>
                Post-produzione artigianale e consegna nei tempi pattuiti, con
                revisioni incluse.
            </p>
        </div>
    </div>
</section>
