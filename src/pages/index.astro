---
// Components
import About from "../components/Home/About.astro";
import Header from "../components/Home/Header.astro";
import Portfolio from "../components/Home/Portfolio.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Home/Hero.astro";
import Stats from "../components/Home/Stats.astro";
import Footer from "../components/Home/Footer.astro";
import Process from "../components/Home/Process.astro";
import CTA from "../components/Home/CTA.astro";
import Featured from "../components/Home/Featured.astro";
import LogoBanner from "../components/Home/LogoBanner.astro";
import ReviewCard from "../components/Home/ReviewCard.astro";

// Styles
import "../styles/style.css"
import Testimonials from "../components/Home/Testimonials.astro";

const headerLinks = [
  { name: "Portfolio", href: "#portfolio" },
  { name: "Chi siamo", href: "#about" },
  { name: "Lavori", href: "#featured" },
  { name: "processo", href: "#process" },
  { name: "Contatti", href: "#contact" },
]

const homeProjects = await fetch(new URL("/api/projects/homepage", Astro.request.url)).then(res => res.json());
const categories = await fetch(new URL("/api/categories", Astro.request.url)).then(res => res.json());
const feedbacks = await fetch(new URL("/api/feedbacks", Astro.request.url)).then(res => res.json());

const bannerLogos: any = [];
---

<Layout>
  <Header links={headerLinks} />
  <Hero />
  <Stats />
  <Portfolio projects={homeProjects} categories={categories} />
  {bannerLogos.length > 0 && <LogoBanner logos={bannerLogos} />}
  <About />
  <Featured />
  <Process />

  <!-- TESTIMONIALS -->
  <Testimonials feedbacks={feedbacks} />

  <CTA />
  <Footer />
  <script is:inline>
    /* ── Intersection reveal ── */
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add("visible");
        });
      },
      { threshold: 0.15 },
    );
    document
      .querySelectorAll(".reveal, .stat-item, .step")
      .forEach((el) => io.observe(el));

    /* ── Filter tabs ── */
    document.querySelectorAll(".filter-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".filter-tab")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.filter;
        document.querySelectorAll(".proj-card").forEach((card) => {
          const match = filter === "all" || card.dataset.cat === filter;
          card.style.display = match ? "" : "none";
        });
        track.scrollLeft = 0;
        updateProgress();
      });
    });

    /* ── Gallery scroll ── */
    const track = document.getElementById("galleryTrack");
    const progress = document.getElementById("galleryProgress");
    const STEP = 480;

    function updateProgress() {
      const max = track.scrollWidth - track.clientWidth;
      const pct = max > 0 ? (track.scrollLeft / max) * 100 : 0;
      progress.style.width = Math.max(8, pct) + "%";
    }

    document.getElementById("scrollLeft").addEventListener("click", () => {
      track.scrollBy({ left: -STEP, behavior: "smooth" });
    });
    document.getElementById("scrollRight").addEventListener("click", () => {
      track.scrollBy({ left: STEP, behavior: "smooth" });
    });
    track.addEventListener("scroll", updateProgress);
    updateProgress();

    /* ── Drag to scroll ── */
    let isDown = false,
      startX,
      scrollStart;
    track.addEventListener("mousedown", (e) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
    });
    document.addEventListener("mouseup", () => {
      isDown = false;
    });
    track.addEventListener("mouseleave", () => {
      isDown = false;
    });
    track.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = scrollStart - (x - startX);
      updateProgress();
    });

    /* ── Navbar scroll ── */
    window.addEventListener("scroll", () => {
      const nav = document.querySelector("nav");
      nav.style.background =
        window.scrollY > 60 ? "rgba(10,10,10,0.97)" : "rgba(10,10,10,0.85)";
    });
  </script>
</Layout>
